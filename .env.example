# Supabase Postgres (same names as Vercel Supabase integration)
# Transaction pooler (port 6543)
POSTGRES_PRISMA_URL="postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Direct / session (port 5432)
POSTGRES_URL_NON_POOLING="postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

AUTH_SECRET="generate-a-long-random-string"
# After Vercel deploy, set this to https://your-app.vercel.app
APP_BASE_URL="http://localhost:3000"
# Auth.js on Vercel (same as APP_BASE_URL in production)
AUTH_URL="http://localhost:3000"

# Telnyx Mission Control
TELNYX_API_KEY="KEY..."
TELNYX_FAX_CONNECTION_ID="your-fax-application-id"
TELNYX_PUBLIC_KEY="your-public-key-for-webhook-verification"

# Vercel Blob (Storage → Blob in Vercel project). Required on Vercel.
BLOB_READ_WRITE_TOKEN=""

# First admin user (created by npm run db:seed)
SEED_ADMIN_EMAIL="faxapp@galatariotis.com"
SEED_ADMIN_PASSWORD="changeme"
SEED_ADMIN_NAME="Admin"

# Company Cyprus fax numbers after porting to Telnyx (E.164)
# Format: +357...|Label,+357...|Label
FAX_NUMBERS="+35722690100|GTL,+35722690201|GALATARIOTIS HONDA LTD,+35724817491|SIGAN MANAGEMENT LTD"
